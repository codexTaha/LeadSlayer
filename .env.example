# Google Gemini API Key (Required for LIVE mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Strict 3-Model Routing Configuration
GEMINI_BRAIN_MODEL=gemini-4-hydrogen
GEMINI_WORKHORSE_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Default Execution Mode: LIVE | SAFE_REPLAY
DEFAULT_EXECUTION_MODE=LIVE

# Backend / Frontend URLs
BACKEND_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Resource & Cache Safety Limits
EMBEDDING_DIM=768
EMBEDDING_CACHE_TTL_SECONDS=21600
EMBEDDING_CACHE_MAX_ENTRIES=1000
MAX_ACTIVE_RUNS=20
SLAYER_CONCURRENCY=5

# Optional Harvey Tier B/C Integrations ($0; leave blank for Safe Sandbox mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=LeadSlayer
SMTP_FROM_EMAIL=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
DO_NOT_CONTACT_DOMAINS=
SENDER_POSTAL_ADDRESS=
